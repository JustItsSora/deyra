# ─────────────────────────────────────────────────────────────
# Deyra Dashboard — variables de entorno (desarrollo local)
# Copiá este archivo a .env.local y completá los valores.
# NUNCA subas .env.local al repo.
# ─────────────────────────────────────────────────────────────

# OAuth de Discord (Developer Portal → tu aplicación → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Exacto, y registrado en OAuth2 → Redirects del portal:
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Secreto de sesión (openssl rand -hex 32)
SESSION_SECRET=

# API admin del bot (la misma máquina donde corre Deyra; usa otro puerto para no
# chocar con el dev server, y en el .env del bot poné ADMIN_PORT=3100)
BOT_API_URL=http://localhost:3100
# El mismo valor que ADMIN_API_KEY en el .env del bot:
BOT_API_KEY=
