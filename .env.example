# ─────────────────────────────────────────────────────────────
# Deyra — variables de entorno
# Copiá este archivo a .env y completá los valores.
#   cp .env.example .env
# NUNCA subas .env a GitHub (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Discord (obligatorio) ──
BOT_TOKEN=                          # token del bot (Developer Portal → Bot)
CLIENT_ID=                          # application id (Developer Portal → General Information)
DEV_GUILD_ID=                       # id del servidor de pruebas: registra ahí los slash al instante en vez de global
OWNER_ID=                           # tu id de usuario de Discord (habilita comandos owner)
PREFIX=!                            # prefijo global para comandos de texto

# ── Base de datos ──
DATABASE_PATH=./data/deyra.sqlite   # ruta al archivo SQLite (se crea solo)

# ── Dashboard / API admin (opcional, pero necesario para el panel web) ──
ADMIN_API_KEY=                      # secreto largo y aleatorio (openssl rand -hex 32); sin esto la API admin no arranca
ADMIN_PORT=3000                     # puerto de la API admin (SERVER_PORT tiene prioridad en hostings tipo bot-hosting.net)
DASHBOARD_ORIGIN=                   # origen permitido para CORS, p.ej. https://deyra-dashboard.vercel.app (vacío = sin CORS)

# ── Identificación ante APIs externas ──
HTTP_APP_NAME=DeyraBot
HTTP_CONTACT=https://github.com/tu-usuario/deyra   # URL real tuya; varias APIs rechazan contactos de relleno

# ── IA (opcional) ──
GROQ_API_KEY=
GEMINI_API_KEY=
AI_ORDER=groq,gemini,pollinations   # orden de proveedores para /ai y el filtro de automod con IA
AI_JSON_MODE=true
AI_POLLINATIONS=true
GROQ_MODEL=
GEMINI_MODEL=
POLLINATIONS_MODEL=

# ── Música (opcional; sin nodos, los comandos de música avisan que está desactivada) ──
LAVALINK_URL=
LAVALINK_PASSWORD=
LAVALINK_NAME=
LAVALINK_SECURE=                    # true/false; si vacío se deduce del protocolo de la URL
LAVALINK_EXTRA_NODES=               # JSON con nodos extra, p.ej. [{"name":"n2","host":"host:port","password":"pw","secure":false}]
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── top.gg votos (opcional) ──
TOPGG_VOTES_ENABLED=false           # true solo si configuraste el webhook; abre VOTES_WEBHOOK_PORT
TOPGG_URL=
TOPGG_WEBHOOK_SECRET=
VOTES_WEBHOOK_PORT=3478

# ── Otros ──
NO_COLOR=                           # cualquier valor desactiva colores en consola
